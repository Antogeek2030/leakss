    <div class="container narrow">
      <h1>Page not found</h1>
      <p class="lede">That page does not exist or has moved.</p>
      <div class="actions"><a class="btn btn-primary" href="/">Go to the home page</a></div>
    </div>
  </section>
</Layout>
