---
import Layout from '../layouts/Layout.astro';
import Map from '../components/Map.astro';
import { SITE, FULL_ADDRESS } from '../config';
import { SERVICES } from '../data/services';
---
<Layout title="Contact Us | Thousand Oaks Leak Detection" description="Call or send a request for a free leak detection quote in Thousand Oaks, Agoura Hills and the Conejo Valley.">
  <section class="page-hero">
    <div class="container">
      <h1>Contact us</h1>
      <p>Call for the fastest response, or send a request and we will get back to you.</p>
    </div>
  </section>
  <section class="section">
    <div class="container two">
      <div>
        <h2>Get in touch</h2>
        <ul class="info-list">
          <li><strong>Phone</strong><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></li>
          <li><strong>Email</strong><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><strong>Address</strong>{FULL_ADDRESS}</li>
        </ul>
        <Map />
      </div>
      <div>
        <h2>Request a free quote</h2>
        <form action={SITE.formAction} method="post" enctype="text/plain">
          <label>Name<input name="name" autocomplete="name" required /></label>
          <label>Phone<input name="phone" type="tel" autocomplete="tel" required /></label>
          <label>Email<input name="email" type="email" autocomplete="email" /></label>
          <label>Service
            <select name="service">
              {SERVICES.map((s) => <option>{s.title}</option>)}
            </select>
          </label>
          <label>What is happening?<textarea name="message" rows="5"></textarea></label>
          <button class="btn btn-primary" type="submit">Send request</button>
        </form>
      </div>
    </div>
  </section>
</Layout>
